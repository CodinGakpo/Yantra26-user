# ============ Django Configuration ============
DJANGO_SECRET_KEY=your_django_secret_key_here

# ============ Neon DB Configuration (PostgreSQL) ============
# Get these from your Neon Dashboard: https://console.neon.tech/
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_neon_database_name
DB_USER=your_neon_username
DB_PASSWORD=your_neon_password
DB_HOST=your_neon_host.neon.tech
DB_PORT=5432

# ============ Firebase Configuration ============
# Path to your Firebase service account JSON file
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json

# Your Firebase Storage bucket name
# Format: projectid.appspot.com
FIREBASE_BUCKET_NAME=your-firebase-bucket-name.appspot.com

# ============ Email Configuration ============
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=ReportMitra <noreply@reportmitra.in>

# ============ Google OAuth Configuration ============
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_ID_APP=your_google_client_id_ios.apps.googleusercontent.com

# ============ Blockchain Configuration ============
BLOCKCHAIN_NODE_URL=http://localhost:7545
BLOCKCHAIN_WS_URL=ws://localhost:7545
BLOCKCHAIN_CONTRACT_ADDRESS=0xYourContractAddressHere
BLOCKCHAIN_CONTRACT_ABI_PATH=blockchain/contracts/build/ComplaintRegistry_abi.json
BLOCKCHAIN_PRIVATE_KEY=0xYourPrivateKeyHere
BLOCKCHAIN_GAS_LIMIT=500000
BLOCKCHAIN_GAS_PRICE_MULTIPLIER=1.1
BLOCKCHAIN_TX_TIMEOUT=120
BLOCKCHAIN_USE_POA=False
BLOCKCHAIN_EXPLORER_URL=https://etherscan.io

# ============ Local File Storage Configuration ============
LOCAL_FILE_UPLOAD_DIR=media/uploads
MEDIA_URL=/media/
MEDIA_ROOT=media
